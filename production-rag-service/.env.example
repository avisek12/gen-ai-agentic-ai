# Copy to .env and fill in for local development against real services.
# Nothing here has a real secret in it — this file is safe to commit;
# .env itself is gitignored.

# Relational store — SQLite needs no setup; switch to Postgres to match production.
DATABASE_URL=sqlite+aiosqlite:///./local.db
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/postgres

# "memory" needs nothing; "pgvector" requires DATABASE_URL to point at a
# real Postgres with the pgvector extension (see docker-compose.yml).
VECTOR_STORE_BACKEND=memory
EMBEDDING_DIM=1536

REDIS_URL=redis://localhost:6379/0

# Leave blank to run against the built-in fake model/embeddings (zero
# cost, deterministic, good for development). Set a real key to use a
# real model.
OPENAI_API_KEY=
CHAT_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# Distributed load controls — see docs/scaling.md for how to size these
# against your actual LLM provider's rate limits.
MAX_CONCURRENT_LLM_CALLS_GLOBAL=20
CONCURRENCY_WAIT_TIMEOUT_SECONDS=3.0
RATE_LIMIT_REQUESTS_PER_WINDOW=30
RATE_LIMIT_WINDOW_SECONDS=60

RESPONSE_CACHE_TTL_SECONDS=3600
